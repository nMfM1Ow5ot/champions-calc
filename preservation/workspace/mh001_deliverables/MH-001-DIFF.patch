+// MH-001: 複数ヒット技のダメージ乱数分布の検証。
+// 契約: ヒットごとのロールは独立で等確率。合計の分布は整数の組合せ数で
+// 畳み込み、要素ごとの合計のような偽の 16 本は作らない。
+// 実行: node tests/test_multihit_dist.mjs (最後に ALL PASS と出す)
+import { Pokemon, Move, Field, calculate } from '@smogon/calc';
+import { gen, convolveHitRolls, damageDistribution, damageRolls, spToEvs } from '../core.mjs';
+
+let failures = 0;
+function check(name, cond, detail = '') {
+  console.log((cond ? 'PASS ' : 'FAIL ') + name + (!cond && detail ? ` (${detail})` : ''));
+  if (!cond) failures++;
+}
+const eq = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+const IVS = { hp: 31, atk: 31, def: 31, spa: 31, spd: 31, spe: 31 };
+
+const WEAVILE = { species: 'Weavile', nature: 'Hardy', ability: 'Pressure', item: '', sp: { atk: 32 } };
+const RILLABOOM = { species: 'Rillaboom', nature: 'Hardy', ability: 'Grassy Surge', item: '', sp: { atk: 32 } };
+const MAUSHOLD = { species: 'Maushold', nature: 'Hardy', ability: 'Technician', item: '', sp: { atk: 32 } };
+const GARCHOMP = { species: 'Garchomp', nature: 'Hardy', ability: 'Rough Skin', item: '', sp: { hp: 32, def: 32 } };
+
+function mirrorPokemon(spec) {
+  return new Pokemon(gen, spec.species, {
+    level: 50, nature: spec.nature, ability: spec.ability, item: spec.item,
+    ivs: IVS, evs: spToEvs(spec.sp),
+  });
+}
+// 参照実装: 小規模な全列挙 (畳み込みとは独立の経路で照合する)
+function bruteForceDist(lists) {
+  let combos = [0];
+  for (const l of lists) {
+    const next = [];
+    for (const c of combos) for (const v of l) next.push(c + v);
+    combos = next;
+  }
+  const freq = new Map();
+  for (const c of combos) freq.set(c, (freq.get(c) || 0) + 1);
+  const values = [...freq.keys()].sort((a, b) => a - b);
+  return { values, counts: values.map(v => freq.get(v)), total: combos.length };
+}
+const distEq = (a, b) => !!a && !!b && eq(a.values, b.values) && eq(a.counts, b.counts) && a.total === b.total;
+
+// --- T01: 2 ヒット同一分布 ---
+{
+  const d = convolveHitRolls([[10, 11, 12, 13], [10, 11, 12, 13]]);
+  check('T01 values', eq(d.values, [20, 21, 22, 23, 24, 25, 26]), JSON.stringify(d.values));
+  check('T01 counts', eq(d.counts, [1, 2, 3, 4, 3, 2, 1]), JSON.stringify(d.counts));
+  check('T01 total', d.total === 16);
+}
+
+// --- T02: 重複値を含むロール ---
+{
+  const d = convolveHitRolls([[10, 10, 11, 12], [10, 10, 11, 12]]);
+  check('T02 values', eq(d.values, [20, 21, 22, 23, 24]), JSON.stringify(d.values));
+  check('T02 counts', eq(d.counts, [4, 4, 5, 2, 1]), JSON.stringify(d.counts));
+  check('T02 total', d.total === 16);
+}
+
+// --- T03: 異なる分布同士 (30〜33 が各 25%) ---
+{
+  const d = convolveHitRolls([[10, 11], [20, 22]]);
+  check('T03 values/counts', eq(d.values, [30, 31, 32, 33]) && eq(d.counts, [1, 1, 1, 1]),
+    JSON.stringify(d));
+  check('T03 each 25%', d.counts.every(c => c / d.total === 0.25));
+}
+
+// --- T04: 16 段階・2〜5 ヒットで全列挙の参照計算と照合 ---
+{
+  const totals = { 2: 256, 3: 4096, 4: 65536, 5: 1048576 };
+  for (let hits = 2; hits <= 5; hits++) {
+    const lists = [];
+    for (let h = 0; h < hits; h++) {
+      const l = [];
+      for (let i = 0; i < 16; i++) l.push(10 + h * 7 + i);
+      lists.push(l);
+    }
+    const d = convolveHitRolls(lists);
+    check(`T04 ${hits} hits total`, d.total === totals[hits], `total=${d.total}`);
+    check(`T04 ${hits} hits matches brute force`, distEq(d, bruteForceDist(lists)));
+  }
+}
+
+// --- T06: T01 の分布で残り HP 23 の KO 確率 ---
+{
+  const d = convolveHitRolls([[10, 11, 12, 13], [10, 11, 12, 13]]);
+  let koCount = 0;
+  d.values.forEach((v, i) => { if (v >= 23) koCount += d.counts[i]; });
+  check('T06 KO probability 62.5%', koCount / d.total === 0.625, `${koCount}/${d.total}`);
+}
+
+// --- T07: 単発技の従来挙動は不変 ---
+{
+  const field = new Field({ gameType: 'Doubles' });
+  const r = calculate(gen, mirrorPokemon(WEAVILE), mirrorPokemon(GARCHOMP), new Move(gen, 'Ice Shard'), field);
+  const expected = Array.isArray(r.damage) ? r.damage : [r.damage];
+  const dr = damageRolls(WEAVILE, GARCHOMP, 'Ice Shard');
+  check('T07 damageRolls single-hit unchanged', eq(dr.rolls, expected) && dr.multi === undefined);
+  const dd = damageDistribution(WEAVILE, GARCHOMP, 'Ice Shard');
+  check('T07 distribution single-hit shape', dd.multi === false && dd.hits === 1 && dd.dist.total === 16
+    && dd.min === Math.min(...expected) && dd.max === Math.max(...expected));
+  check('T07 status shape', eq(damageDistribution(WEAVILE, GARCHOMP, 'Swords Dance'), { status: true }));
+  const drStatus = damageRolls(WEAVILE, GARCHOMP, 'Swords Dance');
+  check('T07 damageRolls status unchanged', eq(drStatus, { rolls: [], status: true }));
+  const fairy = { species: 'Togekiss', nature: 'Hardy', ability: 'Serene Grace', item: '', sp: { hp: 32 } };
+  const garchompAtk = { species: 'Garchomp', nature: 'Hardy', ability: 'Rough Skin', item: '', sp: { atk: 32 } };
+  check('T07 immune shape', eq(damageDistribution(garchompAtk, fairy, 'Dragon Claw'), { immune: true }));
+  const drImm = damageRolls(garchompAtk, fairy, 'Dragon Claw');
+  check('T07 damageRolls immune unchanged', eq(drImm, { rolls: [0], immune: true }));
+}
+
+// --- T09: 代表例 ---
+{
+  // タネマシンガン (ヒット数指定 5)
+  const bs = damageDistribution(RILLABOOM, GARCHOMP, 'Bullet Seed', { moveSpec: 5 });
+  check('T09 Bullet Seed spec 5', bs.multi === true && bs.hits === 5 && bs.dist.total === 1048576
+    && bs.min === bs.dist.values[0] && bs.max === bs.dist.values[bs.dist.values.length - 1],
+    JSON.stringify({ hits: bs.hits, total: bs.dist && bs.dist.total }));
+  const bsRolls = damageRolls(RILLABOOM, GARCHOMP, 'Bullet Seed', { moveSpec: 5 });
+  check('T09 Bullet Seed damageRolls returns dist', bsRolls.rolls === null && bsRolls.multi === true && bsRolls.hits === 5 && distEq(bsRolls.dist, bs.dist));
+  // トリプルアクセル (ヒットごとに威力が異なる)。ライブラリの入れ子結果を
+  // 全列挙した参照分布と照合する
+  const field = new Field({ gameType: 'Doubles' });
+  const rAxel = calculate(gen, mirrorPokemon(WEAVILE), mirrorPokemon(GARCHOMP), new Move(gen, 'Triple Axel'), field);
+  const axel = damageDistribution(WEAVILE, GARCHOMP, 'Triple Axel');
+  check('T09 Triple Axel dist matches brute force', axel.multi === true && axel.hits === 3 && distEq(axel.dist, bruteForceDist(rAxel.damage)),
+    JSON.stringify({ hits: axel.hits, total: axel.dist && axel.dist.total }));
+  // ダブルキック (固定 2 ヒット)
+  const rKick = calculate(gen, mirrorPokemon(WEAVILE), mirrorPokemon(GARCHOMP), new Move(gen, 'Double Kick'), field);
+  const kick = damageDistribution(WEAVILE, GARCHOMP, 'Double Kick');
+  check('T09 Double Kick dist matches brute force', kick.multi === true && kick.hits === 2 && kick.dist.total === 256 && distEq(kick.dist, bruteForceDist(rKick.damage)));
+  // ポピュレーションボム級の 10 ヒット (総数 16^10)
+  const bomb = damageDistribution(MAUSHOLD, GARCHOMP, 'Population Bomb');
+  const sumCounts = bomb.dist ? bomb.dist.counts.reduce((a, b) => a + b, 0) : 0;
+  check('T09 Population Bomb 10 hits', bomb.multi === true && bomb.hits === 10 && bomb.dist.total === 1099511627776 && sumCounts === bomb.dist.total,
+    JSON.stringify({ hits: bomb.hits, total: bomb.dist && bomb.dist.total }));
+}
+
+console.log(failures ? `${failures} FAILURES` : 'ALL PASS');
+process.exit(failures ? 1 : 0);
